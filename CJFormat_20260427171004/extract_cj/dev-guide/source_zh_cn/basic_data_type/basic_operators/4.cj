let a = 2 + 3    // a = 5
let b = 3 - 1    // b = 2
let c = 3 * 4    // c = 12
let d = 7 / 3    // d = 2
let e = 7 / -3   // e = -2, 当遇到“-”时，它具有更高的优先级。
let f = -7 / 3   // f = -2
let g = -7 / -3  // g = 2, 当遇到“-”时，它具有更高的优先级。
let h = 4 % 3    // h = 1
let i = 4 % -3   // i = 1, 当遇到“-”时，它具有更高的优先级。
let j = -4 % 3   // j = -1
let k = -4 % -3  // k = -1, 当遇到“-”时，它具有更高的优先级。

let s1 = "abc"
var s2 = "ABC"
let r1 = s1 + s2 // r1 = "abcABC"