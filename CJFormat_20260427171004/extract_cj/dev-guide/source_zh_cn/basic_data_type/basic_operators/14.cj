var a = !10                 // -11，符合移位和补齐规则
a = !20                     // -21，符合移位和补齐规则
a = 10 << 1                 // 20，符合移位和补齐规则
// a = 1000 << -1           // 编译报错，移位操作溢出（右操作数都不允许为负数）
// a = 1000 << 100000000000 // 编译报错，移位操作溢出（移位越界）
a = 10 << 1 << 1            // 40，符合移位和补齐规则
a = 10 >> 1                 // 5，符合移位和补齐规则
a = 10 & 15                 // 10
a = 10 ^ 15                 // 5
a = 10 | 15                 // 15
a = (1 ^ (8 & 15)) | 24     // 25