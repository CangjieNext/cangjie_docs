var a: Bool = true && true    // a = true
var b: Bool = true && false   // b = false
var c: Bool = false && false  // c = false
var d: Bool = false && true   // d = false

a = true || true              // a = true
b = true || false             // b = true
c = false || false            // c = false
d = false || true             // d = true